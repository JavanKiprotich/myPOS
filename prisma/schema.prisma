generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id           String              @id @default(cuid())
  name         String
  location     String?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  expenses     Expense[]
  inventory    Inventory[]
  movements    InventoryMovement[]
  runningBills RunningBill[]
  sales        Sale[]
  settings     StoreSettings?
  users        User[]
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      UserRole
  storeId   String
  createdAt DateTime   @default(now())
  pin       String?
  active    Boolean    @default(true)
  auditLogs AuditLog[]
  sales     Sale[]     @relation("CashierSales")
  store     Store      @relation(fields: [storeId], references: [id])
}

model Product {
  id               String              @id @default(cuid())
  name             String
  sku              String              @unique
  category         String
  unit             String
  price            Decimal             @db.Decimal(10, 2)
  createdAt        DateTime            @default(now())
  barcode          String?             @unique
  costPrice        Decimal             @default(0) @db.Decimal(10, 2)
  inventory        Inventory[]
  movements        InventoryMovement[]
  runningBillItems RunningBillItem[]
  saleItems        SaleItem[]
}

model Inventory {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, productId])
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  phone         String         @unique
  createdAt     DateTime       @default(now())
  creditAccount CreditAccount?
  runningBills  RunningBill[]
  sales         Sale[]
}

model Sale {
  id         String     @id @default(cuid())
  storeId    String
  customerId String?
  cashierId  String
  total      Decimal    @db.Decimal(10, 2)
  status     SaleStatus @default(COMPLETED)
  syncStatus String     @default("PENDING")
  createdAt  DateTime   @default(now())
  payments   Payment[]
  cashier    User       @relation("CashierSales", fields: [cashierId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])
  store      Store      @relation(fields: [storeId], references: [id])
  items      SaleItem[]
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  unitCost  Decimal? @db.Decimal(10, 2)
  product   Product  @relation(fields: [productId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  reference String?
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id])
}

model CreditAccount {
  id           String              @id @default(cuid())
  customerId   String              @unique
  balance      Decimal             @default(0) @db.Decimal(10, 2)
  updatedAt    DateTime            @updatedAt
  customer     Customer            @relation(fields: [customerId], references: [id])
  transactions CreditTransaction[]
}

model CreditTransaction {
  id              String        @id @default(cuid())
  creditAccountId String
  saleId          String?
  amount          Decimal       @db.Decimal(10, 2)
  type            String
  createdAt       DateTime      @default(now())
  creditAccount   CreditAccount @relation(fields: [creditAccountId], references: [id])
}

model InventoryMovement {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  type      String
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id])
}

model StoreSettings {
  id                    String   @id @default(cuid())
  storeId               String   @unique
  businessName          String?
  phone                 String?
  email                 String?
  address               String?
  currency              String   @default("KES")
  timezone              String   @default("Africa/Nairobi")
  receiptHeader         String?
  receiptFooter         String?
  showCashier           Boolean  @default(true)
  showCustomer          Boolean  @default(true)
  showLogo              Boolean  @default(false)
  autoPrint             Boolean  @default(false)
  printDuplicate        Boolean  @default(false)
  paperWidth            String   @default("80mm")
  enableCash            Boolean  @default(true)
  enableMpesa           Boolean  @default(true)
  enableCredit          Boolean  @default(true)
  allowNegativeStock    Boolean  @default(false)
  minimumStock          Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  defaultPaymentMethod  String   @default("CASH")
  mpesaAutoVerify       Boolean  @default(true)
  mpesaCallbackUrl      String?
  mpesaConsumerKey      String?
  mpesaConsumerSecret   String?
  mpesaEnvironment      String   @default("sandbox")
  mpesaPasskey          String?
  mpesaShortcode        String?
  mpesaTillNumber       String?
  requireFullPayment    Boolean  @default(true)
  autoDeductStock       Boolean  @default(true)
  lowStockAlert         Int      @default(5)
  requireBarcode        Boolean  @default(false)
  stockValuation        String   @default("AVERAGE")
  trackInventory        Boolean  @default(true)
  cashierChangePrice    Boolean  @default(false)
  cashierDeleteSale     Boolean  @default(false)
  cashierPrintReceipt   Boolean  @default(true)
  cashierSell           Boolean  @default(true)
  managerCancelSale     Boolean  @default(true)
  managerPriceOverride  Boolean  @default(true)
  managerRefund         Boolean  @default(true)
  sessionTimeout        Int      @default(30)
  autoLogoutMinutes     Int      @default(30)
  enableAuditLog        Boolean  @default(true)
  minimumPasswordLength Int      @default(8)
  requirePinCashDrawer  Boolean  @default(false)
  requirePinDiscount    Boolean  @default(true)
  requirePinRefund      Boolean  @default(true)
  requirePinVoidSale    Boolean  @default(true)
  autoBackup            Boolean  @default(false)
  backupCustomers       Boolean  @default(true)
  backupFrequency       String   @default("DAILY")
  backupInventory       Boolean  @default(true)
  backupSales           Boolean  @default(true)
  backupSettings        Boolean  @default(true)
  retainBackups         Int      @default(30)
  store                 Store    @relation(fields: [storeId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model RunningBill {
  id         String               @id @default(cuid())
  storeId    String
  customerId String?
  name       String
  phone      String?
  notes      String?
  status     RunningBillStatus    @default(OPEN)
  total      Decimal              @default(0) @db.Decimal(10, 2)
  paid       Decimal              @default(0) @db.Decimal(10, 2)
  openedAt   DateTime             @default(now())
  closedAt   DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  customer   Customer?            @relation(fields: [customerId], references: [id])
  store      Store                @relation(fields: [storeId], references: [id])
  items      RunningBillItem[]
  payments   RunningBillPayment[]
}

model RunningBillItem {
  id            String      @id @default(cuid())
  runningBillId String
  productId     String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  subtotal      Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  unitCost      Decimal?    @db.Decimal(10, 2)
  product       Product     @relation(fields: [productId], references: [id])
  runningBill   RunningBill @relation(fields: [runningBillId], references: [id], onDelete: Cascade)
}

model RunningBillPayment {
  id            String        @id @default(cuid())
  runningBillId String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(VERIFIED)
  reference     String?
  createdAt     DateTime      @default(now())
  runningBill   RunningBill   @relation(fields: [runningBillId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MPESA
  CREDIT
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum RunningBillStatus {
  OPEN
  CLOSED
  CANCELLED
}
